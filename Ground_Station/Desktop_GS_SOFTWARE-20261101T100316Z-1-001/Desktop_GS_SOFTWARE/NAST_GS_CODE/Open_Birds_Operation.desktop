[Desktop Entry]
Version=1.0
Type=Application
Name=NAST Ground Station (Open Birds Operation)
Comment=Launch NAST / Slippers2Sat Ground Station Software (CW, HK, Camera, Digipeater)
Exec=bash -c 'f="%k"; f="${f#file://}"; if [ -n "$f" ] && [ -e "$f" ]; then d="$(cd "$(dirname "$f")" && pwd)"; if [ -x "$d/run_gs_software.sh" ]; then exec "$d/run_gs_software.sh"; fi; fi; for c in "./run_gs_software.sh" "./Ground_Station/Desktop_GS_SOFTWARE-20261101T100316Z-1-001/Desktop_GS_SOFTWARE/NAST_GS_CODE/run_gs_software.sh" "$HOME/Desktop/nuttxspace/Ground_Station/Desktop_GS_SOFTWARE-20261101T100316Z-1-001/Desktop_GS_SOFTWARE/NAST_GS_CODE/run_gs_software.sh" "$HOME/nuttxspace/Ground_Station/Desktop_GS_SOFTWARE-20261101T100316Z-1-001/Desktop_GS_SOFTWARE/NAST_GS_CODE/run_gs_software.sh"; do if [ -x "$c" ]; then exec "$c"; fi; done; found="$(find "$HOME" -maxdepth 6 -name run_gs_software.sh 2>/dev/null | head -n 1)"; if [ -n "$found" ]; then exec "$found"; fi'
Icon=utilities-terminal
Terminal=false
Categories=Development;Science;HamRadio;
StartupNotify=true
