[Desktop Entry]
Version=1.0
Type=Application
Name=Slippers2Sat Ground Station (OpenBirdsOperation)
Comment=NAST Ground Station Software with CW Beacon Decoder
Exec=bash -c 'f="%k"; f="${f#file://}"; d="$(cd "$(dirname "$f")" && pwd)"; cd "$d" && exec ./run_gs_software.sh'
Icon=s2s_logo
Terminal=false
Categories=Science;Utility;HamRadio;
MimeType=application/x-ms-dos-executable;application/x-msdownload;application/x-dosexec;application/vnd.microsoft.portable-executable;
